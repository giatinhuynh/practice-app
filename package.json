{
  "name": "practice-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <27"
  },
  "scripts": {
    "dev": "next dev demo --hostname 127.0.0.1",
    "build": "next build demo",
    "start": "next start demo --hostname 127.0.0.1",
    "lint": "eslint demo tests playwright.config.ts vitest.config.ts",
    "typecheck": "tsc --noEmit -p demo/tsconfig.json",
    "test:unit": "vitest run",
    "test:e2e": "playwright test tests/events.spec.ts --grep-invert @visual",
    "check": "npm run lint && npm run typecheck && npm run test:unit",
    "verify": "npm run check && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.1",
    "eslint-config-next": "16.4.2",
    "playwright-core": "1.64.0",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
